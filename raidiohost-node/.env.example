# Runtime mode and HTTP listener
NODE_ENV=development
PORT=3050

# Use a dedicated database user outside local Compose development.
MONGODB_URI=mongodb://<username>:<password>@<host>:27017/raidiohost?authSource=admin

# Spotify Authorization Code application settings. Never expose CLIENT_SECRET to Vite.
CLIENT_ID=<spotify-client-id>
CLIENT_SECRET=<spotify-client-secret>
REDIRECT_URL=http://127.0.0.1:8080/auth/callback

# Replace with a high-entropy value. Phase 1 will split signing and encryption keys.
JWT_KEY=<generate-a-high-entropy-secret>

# Comma-separated exact origins; do not use wildcards with credentials.
CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8080
