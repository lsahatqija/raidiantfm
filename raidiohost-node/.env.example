# Runtime mode and HTTP listener
NODE_ENV=development
PORT=3050

# Use a dedicated database user outside local Compose development.
MONGODB_URI=mongodb://<username>:<password>@<host>:27017/raidiohost?authSource=admin

# Spotify Authorization Code application settings. Never expose CLIENT_SECRET to Vite.
CLIENT_ID=<spotify-client-id>
CLIENT_SECRET=<spotify-client-secret>
REDIRECT_URL=http://127.0.0.1:8080/auth/callback
# Use "development" unless Spotify has approved this client for Extended Quota Mode.
SPOTIFY_QUOTA_MODE=development

# Exact public browser origin used after authentication.
APP_ORIGIN=http://127.0.0.1:8080

# Comma-separated exact origins; do not use wildcards with credentials.
CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8080

# Deployment boundary settings. Production must use HTTPS and secure cookies.
TRUST_PROXY=1
COOKIE_SECURE=false
SESSION_COOKIE_NAME=raidiantfm_session

# Generate independently. SESSION_SECRET must have at least 32 characters.
SESSION_SECRET=<generate-a-high-entropy-session-secret>
# Generate exactly 32 random bytes and encode them as base64.
TOKEN_ENCRYPTION_KEY=<base64-encoded-32-byte-key>

# Request body and shared Mongo-backed abuse limits.
JSON_BODY_LIMIT=16kb
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
EXTERNAL_RATE_LIMIT_MAX=30
EXTERNAL_RATE_LIMIT_WINDOW_MS=60000
